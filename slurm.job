#!/bin/bash
#SBATCH -J Melspec
#SBATCH -w hepnode[1-3]
#SBATCH -N 1
#SBATCH -n 16
#SBATCH --output=logs/%j.out
#SBATCH --error=logs/%j.err

set -euo pipefail

IMPLEMENTATION="${IMPLEMENTATION:-exp/001_packed_fft_sparse_mel_simd.cpp}"
if [[ -n "${EXPERIMENT:-}" ]]; then
    IMPLEMENTATION="exp/${EXPERIMENT}.cpp"
fi
EXPERIMENT_NAME="$(basename "${IMPLEMENTATION}" .cpp)"
LOG_FILE="logs/${EXPERIMENT_NAME}_slurm-${SLURM_JOB_ID:-manual}.log"

# One process owns the allocation; let OpenMP use one worker per Slurm task.
export OMP_NUM_THREADS="${SLURM_CPUS_PER_TASK:-${SLURM_NTASKS:-1}}"
export OMP_PROC_BIND="${OMP_PROC_BIND:-close}"
export OMP_PLACES="${OMP_PLACES:-cores}"

# active your env here
mkdir -p logs
{
    printf 'Implementation: %s\n' "${IMPLEMENTATION}"
    printf 'Git revision: %s\n' "$(git rev-parse HEAD 2>/dev/null || printf 'unknown')"
    printf 'Slurm job: %s\n' "${SLURM_JOB_ID:-manual}"
    printf 'Node: %s\n' "$(hostname)"
    printf 'OpenMP threads: %s\n' "${OMP_NUM_THREADS}"
    make clean
    make test IMPLEMENTATION="${IMPLEMENTATION}"
} 2>&1 | tee "${LOG_FILE}"
